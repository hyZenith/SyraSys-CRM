generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("Sales Manager") // "Admin", "Sales Manager", "Account Manager", "Project Manager", "Lead Manager"
  
  // Better Auth sessions and accounts
  sessions      Session[]
  accounts      Account[]
  
  // Audit Logs
  auditLogs     AuditLog[] @relation("ActorRelation")
  targetLogs    AuditLog[] @relation("TargetRelation")
  
  // Assigned Leads
  assignedLeads Lead[]

  // Created Proposals
  createdProposals Proposal[] @relation("ProposalCreator")
  // Assigned Customers
  assignedCustomers Customer[] @relation("CustomerAssignee")
}

model Session {
  id             String   @id
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invite {
  id         String    @id @default(uuid())
  email      String    @unique
  role       String    // The assigned role upon signup
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  targetUserId String?
  action       String   // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "MFA_RESET", "INVITE_SENT", "ROLE_CHANGED"
  metadata     String?  // JSON string
  createdAt    DateTime @default(now())

  actor        User     @relation("ActorRelation", fields: [actorUserId], references: [id])
  target       User?    @relation("TargetRelation", fields: [targetUserId], references: [id])
}

model Lead {
  id             String    @id @default(uuid())
  status         String    @default("Contacted") // e.g. "Contacted", "Negotiation", "Offer sent", "Deal closed"
  tag            String    @default("New lead")  // e.g. "New lead", "Returning", "Priority", "Follow-up"
  company        String
  description    String
  dueDate        String?
  links          String[]  // Only link URLs can be stored
  comments       String[]  // Important comments added by admin about the deal

  // Assigned user details
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  assigneeName   String?
  assigneeRole   String?
  assigneeAvatar String?

  // Proposal tracking
  proposals          Proposal[]
  proposalDocuments  ProposalDocument[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Proposal {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  createdById    String?
  createdBy      User?     @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title          String
  description    String
  status         String    @default("Draft") // e.g. "Draft", "Sent", "Accepted", "Declined"
  totalAmount    Float
  currency       String    @default("USD")
  dueDate        DateTime?
  
  // Proposal document and PDF links
  documentUrl    String?   // Link to proposal doc
  pdfUrl         String?   // Link to proposal PDF file

  // Proposal document attachments
  documents      ProposalDocument[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ProposalDocument {
  id          String    @id @default(uuid())
  proposalId  String
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  name        String    // Document name / title
  fileUrl     String    // PDF or Doc file URL link
  fileType    String?   // e.g. "pdf", "docx", "doc"
  fileSize    Int?      // File size in bytes
  
  uploadedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id             String     @id @default(uuid())
  name           String
  company        String
  email          String
  phone          String?
  status         String     @default("Active") // e.g. "Active", "Inactive", "Onboarding", "VIP"
  tag            String     @default("Client")  // e.g. "Enterprise", "SMB", "Client"
  description    String?
  avatar         String?
  
  // Assigned rep
  assignedUserId String?
  assignedUser   User?      @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assigneeName   String?
  assigneeRole   String?
  assigneeAvatar String?

  // Module Features
  contracts      Contract[]
  ndas           Nda[]
  invoices       Invoice[]
  payments       Payment[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Contract {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("Active") // "Draft", "Active", "Expired", "Terminated"
  value       Float
  startDate   DateTime
  endDate     DateTime?
  documentUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Nda {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("Signed") // "Pending", "Signed", "Expired"
  signedDate  DateTime?
  documentUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Invoice {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber String  @unique
  amount      Float
  status      String    @default("Pending") // "Draft", "Pending", "Paid", "Overdue"
  dueDate     DateTime
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount      Float
  method      String    @default("Bank Transfer") // "Credit Card", "Bank Transfer", "PayPal"
  status      String    @default("Completed") // "Completed", "Pending", "Failed"
  paidAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

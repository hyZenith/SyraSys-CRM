{
  "name": "@syracrm/api",
  "version": "0.1.0",
  "description": "NestJS API scaffold for Syracrm monorepo",
  "author": "Syracrm",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node dist/main.js\"",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@syracrm/auth": "workspace:*",
    "@syracrm/constants": "workspace:*",
    "@syracrm/database": "workspace:*",
    "@syracrm/types": "workspace:*",
    "@syracrm/utils": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.7.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
